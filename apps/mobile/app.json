{
  "expo": {
    "name": "FitMaster",
    "slug": "fitmaster",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "splash": {
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitmaster.app"
    },
    "android": {
      "package": "com.fitmaster.app",
      "adaptiveIcon": {
        "backgroundColor": "#C1EF00"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
